# Configuration de popotte — copier en .env et adapter si besoin.
#   cp .env.example .env
# Fichier optionnel : sans lui, les valeurs par défaut ci-dessous s'appliquent.
# Il n'est pas versionné (il peut contenir la clé de session).
#
# Ces variables sont celles exposées par docker-compose.yml. Sous Portainer,
# elles se saisissent dans l'écran « Environment variables » de la stack
# plutôt que dans ce fichier.

# Fuseau horaire du conteneur : sert à dater les listes de courses.
TZ=Europe/Paris

# Recettes d'exemple créées au tout premier démarrage (base vide).
# Mettre 0 pour démarrer avec un catalogue vierge.
POPOTTE_SEED_DEMO=1

# Clé de session (mémorise le panier en cours d'un rechargement à l'autre).
# Laissée vide, elle est générée et persistée dans le volume de données.
# À renseigner uniquement si vous voulez la maîtriser vous-même :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
POPOTTE_SECRET_KEY=

# Les autres réglages (POPOTTE_DATA_DIR, POPOTTE_DATABASE_URL, POPOTTE_DEBUG)
# ne sont pas exposés par le compose : /data est figé côté image et correspond
# au volume monté. Les modifier n'a de sens qu'en développement local, en
# préfixant la commande :
#   POPOTTE_DEBUG=1 .venv/bin/python wsgi.py
